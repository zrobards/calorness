# Copy this file to .env and fill in the values. Never commit .env.

# Postgres (Neon via the Vercel Storage tab). Pooled URL for the app,
# direct (non-pooled) URL for running migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/calorness?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/calorness?sslmode=require"

# Signs session cookies. Generate one with: npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=""

# The site's own URL. http://localhost:3000 locally; your Vercel URL in production.
NEXTAUTH_URL="http://localhost:3000"

# GitHub sign-in: github.com/settings/developers → New OAuth App
# Callback URL: <your site>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google sign-in (optional): console.cloud.google.com → Credentials → OAuth client
# Callback URL: <your site>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Shows a "Try the demo account" button (one shared account, no password).
DEMO_LOGIN_ENABLED="true"
