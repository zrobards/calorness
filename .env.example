# Copy this file to .env and fill in the values. Never commit .env.

# Postgres (Neon via the Vercel Storage tab). Pooled URL for the app,
# direct (non-pooled) URL for running migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/calorness?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/calorness?sslmode=require"

# Signs session cookies. Generate one with: npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=""

# The site's own URL. http://localhost:3000 locally; your Vercel URL in production.
NEXTAUTH_URL="http://localhost:3000"

# GitHub sign-in: github.com/settings/developers → New OAuth App
# Callback URL: <your site>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google sign-in (optional): console.cloud.google.com → Credentials → OAuth client
# Callback URL: <your site>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Shows a "Try the demo account" button (one shared account, no password).
DEMO_LOGIN_ENABLED="true"

# Food search: free key from https://fdc.nal.usda.gov/api-key-signup
# Without one the app uses DEMO_KEY, which only allows a few searches an hour.
USDA_API_KEY=""

# AI meal logging (photo and describe): key from console.anthropic.com.
# Optional AI_MODEL overrides the default Claude model (claude-haiku-5-5).
ANTHROPIC_API_KEY=""

# Your email here (comma-separated for more) unlocks the owner-only /admin data page.
ADMIN_EMAILS=""
# Optional model overrides. Photos and label scans default to claude-sonnet-5-5;
# typed descriptions and Coach default to claude-haiku-5-5.
AI_VISION_MODEL=""
AI_MODEL=""
AI_COACH_MODEL=""

# Optional: an iCloud link to a ready-made Apple Health Shortcut, shown as a button in Profile.
HEALTH_SHORTCUT_URL=""
