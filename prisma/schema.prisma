// Calorness database schema
// Everything is stored in metric (kg, cm, ml, g). The UI converts to the
// user's preferred units, so math and comparisons never mix unit systems.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (used by the app)
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection (used by migrations)
}

// ─── Auth (shape required by the Auth.js Prisma adapter) ───────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // only for email + password accounts (bcrypt)
  unitSystem    UnitSystem @default(IMPERIAL)
  timeZone      String     @default("America/New_York") // the phone's zone, so "today" matches your day
  restAlarmAt   DateTime? // when a "rest's over" notification is due; cleared to cancel it
  // Body stats, used to estimate calories burned and daily needs
  sex            String? // "male" or "female" (for the calorie equations)
  birthYear      Int?
  heightCm       Float?
  exerciseCredit Int     @default(75) // % of exercise calories added to the day's calorie goal
  // Daily activity goals (Apple Health sync or manual)
  stepGoal         Int     @default(8000)
  activeCalGoal    Int     @default(500)
  exerciseMinGoal  Int     @default(30)
  // When Apple Health sends active calories for a day, use them for the
  // exercise credit instead of adding up logged cardio (they already include it)
  useHealthCalories Boolean @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts        Account[]
  sessions        Session[]
  goal            Goal?
  customExercises Exercise[]
  routines        Routine[]
  workouts        Workout[]
  customFoods     Food[]
  diaryEntries    DiaryEntry[]
  waterEntries    WaterEntry[]
  bodyweights     BodyweightEntry[]
  apiKeys         ApiKey[]
  savedMeals      SavedMeal[]
  pushSubscriptions PushSubscription[]
  aiCalls         AiCall[]
  coachNotes      CoachNote[]
  coachMessages   CoachMessage[]
  coachChats      CoachConversation[]
  searchPicks     SearchPick[]
  activities      ActivityEntry[]
  foodSubmissions FoodSubmission[]
  dailyActivity   DailyActivity[]
  programs        Program[]
  aiCorrections   AiCorrection[]
  music           MusicLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  refresh_token_expires_in Int? // sent by GitHub Apps; storing it keeps sign-in from failing

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UnitSystem {
  IMPERIAL
  METRIC
}

// ─── Training (Hevy-style) ─────────────────────────────────────────────────

// Library exercises have createdById = null. Users can add their own.
model Exercise {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  category         ExerciseCategory @default(STRENGTH)
  equipment        String?
  level            String? // beginner, intermediate, expert
  mechanic         String? // compound or isolation
  aliases          String[] @default([]) // other names people use, like "pec deck" for Butterfly
  primaryMuscles   String[]
  secondaryMuscles String[]
  instructions     String[]
  images           String[]
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())

  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]

  @@index([name])
  @@index([createdById])
}

enum ExerciseCategory {
  STRENGTH
  CARDIO
  STRETCHING
  PLYOMETRICS
}

// A saved template, like "Push A" or "Upper body"
// A program bundles routines (e.g. "Push/Pull/Legs" = Push, Pull, Legs).
// Routines can also stand alone.
model Program {
  id        String   @id @default(cuid())
  userId    String
  name      String
  summary   String?
  position  Int      @default(0)
  pinned    Boolean  @default(false) // the program you're running now, shown first and open
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  routines Routine[]

  @@index([userId, position])
}

model Routine {
  id        String   @id @default(cuid())
  userId    String
  programId String?
  name      String
  notes     String?
  position  Int      @default(0) // order within its program (or among standalone routines)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  exercises RoutineExercise[]
  workouts  Workout[]

  @@index([userId])
  @@index([programId, position])
}

model RoutineExercise {
  id            String  @id @default(cuid())
  routineId     String
  exerciseId    String
  order         Int
  targetSets    Int     @default(3)
  targetRepsMin Int?
  targetRepsMax Int?
  restSeconds   Int     @default(90)
  supersetGroup Int? // exercises sharing a number are performed as a superset
  notes         String?

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([routineId])
}

// One actual gym session
model Workout {
  id        String    @id @default(cuid())
  userId    String
  routineId String?
  name      String
  notes     String?
  startedAt DateTime  @default(now())
  endedAt   DateTime? // null while the workout is in progress
  updatedAt DateTime  @default(now()) @updatedAt // last autosave, to pick the newest copy across devices

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine   Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  exercises WorkoutExercise[]

  @@index([userId, startedAt])
}

model WorkoutExercise {
  id            String  @id @default(cuid())
  workoutId     String
  exerciseId    String
  order         Int
  supersetGroup Int?
  notes         String?

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String  @id @default(cuid())
  workoutExerciseId String
  order             Int
  type              SetType @default(NORMAL)
  weightKg          Float?
  reps              Int?
  durationSec       Int? // for timed holds and cardio
  distanceM         Float? // for cardio
  rpe               Float? // rate of perceived exertion, 1–10
  completed         Boolean @default(false)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

enum SetType {
  WARMUP
  NORMAL
  DROP
  FAILURE
}

// ─── Nutrition (MyFitnessPal-style) ───────────────────────────────────────

// Foods are cached locally from USDA / Open Food Facts, or created by users.
// Nutrient values are per one serving.
model Food {
  id          String     @id @default(cuid())
  source      FoodSource
  externalId  String? // USDA fdcId or Open Food Facts code
  barcode     String?
  name        String
  brand       String?
  servingSize Float
  servingUnit String // "g", "ml", "cup", "slice", ...
  servingLabel String? // how the label describes it, like "1 container (150 g)"
  calories    Float
  proteinG    Float
  carbsG      Float
  fatG        Float
  fiberG      Float?
  sugarG      Float?
  sodiumMg    Float?
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  // Copied from a printed Nutrition Facts label, so it's shared with everyone
  // (name and numbers only) to grow the food database
  shared      Boolean    @default(false)
  // brand + name squashed to letters and digits, maintained by a database
  // trigger (see the search_cache_and_index migration) for fast fuzzy search
  searchKey   String     @default("") @map("search_key")
  // For COMMUNITY foods: how many different people entered matching numbers
  confirmations Int      @default(0)
  createdAt   DateTime   @default(now())

  diaryEntries DiaryEntry[]
  savedMealItems SavedMealItem[]
  searchPicks    SearchPick[]

  @@unique([source, externalId])
  @@index([barcode])
  @@index([name])
  @@index([searchKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "Food_search_key_trgm")
}

enum FoodSource {
  USDA
  OPEN_FOOD_FACTS
  CUSTOM
  AI_ESTIMATE // estimated by AI from a photo or description
  COMMUNITY // built from matching entries by several different people
}

model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  foodId    String
  date      DateTime @db.Date // the user's local calendar day
  meal      Meal
  servings  Float    @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, createdAt]) // "usual foods" looks back six weeks
}

enum Meal {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

model WaterEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  ml        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ─── Body + goals ─────────────────────────────────────────────────────────

model BodyweightEntry {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @db.Date
  weightKg Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Goal {
  id             String   @id @default(cuid())
  userId         String   @unique
  goalType       GoalType @default(MAINTAIN)
  calories       Int
  proteinG       Int
  carbsG         Int
  fatG           Int
  waterMl        Int      @default(2500)
  targetWeightKg Float?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GoalType {
  LOSE
  MAINTAIN
  GAIN
}

// ─── Home-screen app sign-in handoff ──────────────────────────────────────
// On iPhone, an app added to the home screen keeps its own cookies, separate
// from the browser window GitHub sign-in happens in. The app creates a
// request, you approve it after signing in, and the app trades the approved
// request for its own session. Requests expire after 10 minutes and work once.
model LoginRequest {
  id         String    @id // long random secret, never shown in full
  code       String // short code shown on both screens so you can match them
  userId     String?
  approvedAt DateTime?
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

// ─── Phone shortcut keys ──────────────────────────────────────────────────
// Lets an iPhone Shortcut (or Android automation) log meals without opening
// the app. Only a SHA-256 hash of the key is stored; the key itself is shown
// once when it's created.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String // first characters, so you can tell keys apart
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Saved meals ──────────────────────────────────────────────────────────
model SavedMeal {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  lastUsed  DateTime?
  items     SavedMealItem[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedMealItem {
  id          String @id @default(cuid())
  savedMealId String
  foodId      String
  servings    Float

  savedMeal SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  food      Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)
}

// ─── Notifications ────────────────────────────────────────────────────────
// One row per phone/browser that allowed notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// App-wide secrets the app creates for itself (the notification signing keys),
// so there's nothing extra to set up in Vercel.
model AppSecret {
  key   String @id
  value String
}

// One row per AI request, so each person can have a fair daily limit and the
// AI bill stays predictable when friends use the app.
model AiCall {
  id        String   @id @default(cuid())
  userId    String
  kind      String // "photo", "describe", "label", "shortcut"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Coach ────────────────────────────────────────────────────────────────
// Things you've told the AI coach that it should keep in mind: injuries,
// goals, preferences. You can see and delete every one in the Coach screen.
model CoachNote {
  id        String   @id @default(cuid())
  userId    String
  kind      String // "injury", "goal", "preference", "other"
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

// One Coach chat. You can go back to old ones from the Chats list.
model CoachConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt])
}

model CoachMessage {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  role      String // "user" or "assistant"
  content   String   @db.Text
  proposal  Json? // a reworked routine or a whole program the coach suggested, shown with buttons
  createdAt DateTime @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation CoachConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

// Which food you picked for a search, so next time "chickfila" puts the
// grilled nuggets you always log at the top, even if the name doesn't match.
model SearchPick {
  id     String   @id @default(cuid())
  userId String
  query  String // normalized search words
  foodId String
  count  Int      @default(1)
  lastAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, query, foodId])
  @@index([userId])
  @@index([query]) // community ranking: what everyone picked for a search
}

// Results from USDA and Open Food Facts, kept for a week so popular searches
// are instant and don't count against API limits. Only non-empty results.
model SearchCache {
  key       String   @id // source + normalized query
  results   Json
  createdAt DateTime @default(now())
}

// ─── Cardio and other activities ──────────────────────────────────────────
// Running, climbing, hacky sack, basketball… anything that isn't sets and reps.
model ActivityEntry {
  id            String   @id @default(cuid())
  userId        String
  activity      String // key from the activity catalog (src/lib/fitness/activities.ts), or "custom"
  name          String // shown name, e.g. "Rock climbing" or your own
  intensity     String   @default("moderate") // light, moderate, vigorous
  date          DateTime @db.Date // your local calendar day
  startedAt     DateTime @default(now())
  durationMin   Float
  distanceM     Float?
  inclinePct    Float?
  avgHeartRate  Int?
  caloriesTotal Int // everything burned during the activity
  caloriesNet   Int // above what you'd burn resting anyway (what gets added to your day)
  method        String // how it was estimated: "heart-rate", "acsm", or "met"
  notes         String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, startedAt])
}

// Slows down password guessing: after too many wrong passwords for one
// email, sign-in for that email pauses for 15 minutes.
model AuthThrottle {
  key         String    @id // "pw:<email>"
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

// Playlists, albums, or songs saved from YouTube Music, Spotify, Apple Music,
// or SoundCloud, played in each service's own embedded player.
model MusicLink {
  id           String   @id @default(cuid())
  userId       String
  service      String // youtube, spotify, apple, soundcloud
  url          String
  embedUrl     String
  title        String
  lastPlayedAt DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Learning from everyone's entries ─────────────────────────────────────
// A food someone typed in by hand. Private on its own; when enough different
// people enter matching numbers for the same food, a shared COMMUNITY food
// is created from the typical values. Only the food's name and numbers are
// ever shared, never who entered it.
model FoodSubmission {
  id           String   @id @default(cuid())
  userId       String
  foodId       String // their own private food
  key          String // brand + name, normalized (see lib/nutrition/community.ts)
  name         String
  brand        String?
  servingLabel String?
  servingSize  Float
  servingUnit  String
  calories     Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([key])
}

// When someone fixes an AI estimate by typing the real numbers, how far off
// the AI was for that kind of food. Pooled across people, these nudge future
// estimates (e.g. "people say chicken burritos run 15% higher").
model AiCorrection {
  id            String   @id @default(cuid())
  userId        String
  key           String // normalized food name
  aiCalories    Float
  finalCalories Float
  aiProteinG    Float
  finalProteinG Float
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
}

// ─── Daily activity from Apple Health (via an iPhone Shortcut) ───────────
// One row per day. The Shortcut sends the day's totals; sending again
// replaces them, so it can run several times a day.
model DailyActivity {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date
  steps           Int?
  activeCalories  Int? // Apple's "active energy": above resting, includes workouts
  exerciseMinutes Int?
  distanceM       Float? // walking + running
  walkingSpeedMps Float? // average walking speed
  flights         Int?
  restingHr       Int?
  source          String   @default("apple-health")
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
